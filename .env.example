# Copy this file to .env and replace every secret before deployment.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/smart-building
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES=8h
HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_MAX=300
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword!123
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=ChangeThisAnalystPassword!123
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=ChangeThisViewerPassword!123
